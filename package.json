{
  "name": "agentc",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"!agentc\" run build",
    "dev:control-plane": "pnpm --filter @agentc/control-plane dev",
    "dev:web": "pnpm --filter @agentc/web dev",
    "db:generate": "pnpm --filter @agentc/database generate",
    "db:migrate": "pnpm --filter @agentc/database migrate",
    "typecheck": "pnpm -r --filter \"!agentc\" run typecheck",
    "test": "pnpm --filter @agentc/protocol test && pnpm --filter @agentc/control-plane test && pnpm --filter @agentc/web test && pnpm --filter @agentc/agent-runtime test",
    "spike": "pnpm --filter @agentc/control-plane spike",
    "agentc": "pnpm --filter @agentc/cli start",
    "start": "node apps/control-plane/dist/index.js"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
