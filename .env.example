# App server (Pi, browser UI, API, and WebSockets share this process)
PORT=8787
HOST=0.0.0.0
# Generate each secret with: openssl rand -hex 32
CONTROL_PLANE_API_KEY=dev-api-key-change-me
BROWSER_SESSION_SECRET=change-me-browser-secret
# Optional compatibility fallback for BROWSER_SESSION_SECRET; never sent to Daytona.
RUNTIME_ACCESS_SECRET=change-me-runtime-secret

# Persistent server storage. On Railway, attach a volume at /data and omit these
# two overrides: RAILWAY_VOLUME_MOUNT_PATH automatically supplies both defaults.
# DATABASE_URL=file:/absolute/path/cloud-agent.db
# PI_AGENT_DIR=/absolute/path/pi

# Daytona runs repository clones, file tools, shell commands, and project servers.
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=
DAYTONA_SNAPSHOT=
WORKSPACE_PATH=/home/daytona/workspace/project

# Nebius Token Factory. These credentials stay on the app server.
PI_PROVIDER=nebius
PI_MODEL=moonshotai/Kimi-K2.7-Code
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Optional free-model fallback; not required for Nebius.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_HTTP_REFERER=https://agent.example.com
# OPENROUTER_APP_TITLE=cloud-agent
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# CLI
CLOUD_AGENT_URL=http://127.0.0.1:8787
CLOUD_AGENT_USER_ID=default-user
