# Control plane
PORT=8787
HOST=0.0.0.0
# Generate with: openssl rand -hex 32
CONTROL_PLANE_API_KEY=dev-api-key-change-me
# Relative file: paths follow the process working directory.
# On a server, use an absolute path, e.g. file:/var/lib/cloud-agent/cloud-agent.db
DATABASE_URL=file:./data/cloud-agent.db

# Daytona
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=
DAYTONA_SNAPSHOT=

# Sandbox runtime (injected into each sandbox)
RUNTIME_PORT=4096
WORKSPACE_PATH=/home/daytona/workspace/project
PI_AGENT_DIR=/home/daytona/.pi/agent

# LLM — OpenRouter (preferred; Daytona Tier 1/2 allowlists openrouter.ai)
OPENROUTER_API_KEY=
# Also required for automatic free-model fallback when another provider is primary.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional attribution headers sent to OpenRouter.
# OPENROUTER_HTTP_REFERER=https://agent.example.com
# OPENROUTER_APP_TITLE=cloud-agent
PI_PROVIDER=openrouter
# Tool-capable coding model. Choose an OpenRouter model with tools support.
PI_MODEL=qwen/qwen3-235b-a22b-2507

# Optional: Nebius Token Factory (not reachable from Daytona Tier 1/2)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Generate with: openssl rand -hex 32
# Keep this stable. Existing sandboxes are redeployed when it changes.
RUNTIME_ACCESS_SECRET=change-me-runtime-secret

# CLI
CLOUD_AGENT_URL=http://127.0.0.1:8787
CLOUD_AGENT_USER_ID=default-user

# Sign browser ownership cookies and chat tokens.
# Generate with: openssl rand -hex 32
# Empty falls back to RUNTIME_ACCESS_SECRET. Set a distinct value on a server.
# Changing it signs every browser out of its workspaces.
BROWSER_SESSION_SECRET=
