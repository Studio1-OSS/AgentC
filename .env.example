# App server (Pi, browser UI, API, and WebSockets share this process)
PORT=8787
HOST=0.0.0.0
# Generate each secret with: openssl rand -hex 32
CONTROL_PLANE_API_KEY=dev-api-key-change-me
# Public URL of this deployment (used for canonical links, Open Graph and the
# sitemap). Defaults to the request's own origin when unset.
# PUBLIC_SITE_URL=https://agent.example.com
BROWSER_SESSION_SECRET=change-me-browser-secret
# Optional compatibility fallback for BROWSER_SESSION_SECRET; never sent to Daytona.
RUNTIME_ACCESS_SECRET=change-me-runtime-secret

# Persistent server storage. On Railway, attach a volume at /data and omit these
# two overrides: RAILWAY_VOLUME_MOUNT_PATH automatically supplies both defaults.
# DATABASE_URL=file:/absolute/path/agentc.db
# PI_AGENT_DIR=/absolute/path/pi

# Daytona runs repository clones, file tools, shell commands, and project servers.
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=
DAYTONA_SNAPSHOT=
WORKSPACE_PATH=/home/daytona/workspace/project

# Nebius Token Factory. These credentials stay on the app server.
PI_PROVIDER=nebius
PI_MODEL=meta-models/muse-spark-open
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Optional free-model fallback; not required for Nebius.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_HTTP_REFERER=https://agent.example.com
# OPENROUTER_APP_TITLE=agentc
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# CLI
AGENTC_URL=http://127.0.0.1:8787
AGENTC_USER_ID=default-user

# GitHub App (optional): lets users sign in with GitHub, open their own
# repositories (including private ones) and create pull requests.
# Callback URL to register on the app: <your site>/ui/api/github/callback
# (for local dev: http://localhost:5173/ui/api/github/callback)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Path to the app's .pem private key (keep it outside the repository),
# or set GITHUB_APP_PRIVATE_KEY to the PEM contents with \n for newlines.
GITHUB_APP_PRIVATE_KEY_PATH=
